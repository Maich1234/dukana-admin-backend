{
 "version": 2,
 "builds": [
  {
   "src": "index.js",
   "use": "@vercel/node",
   "config": {
    "maxDuration": 60
   }
  }
 ],
 "routes": [
  {
   "src": "/(.*)",
   "dest": "index.js"
  }
 ],
 "crons": [
  {
   "path": "/api/v1/cron/commission-accrual",
   "schedule": "0 4 * * *"
  },
  {
   "path": "/api/v1/cron/reconcile-b2c-payouts",
   "schedule": "0 5 * * *"
  }
 ]
}
