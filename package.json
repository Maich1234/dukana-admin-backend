{
  "name": "dukana-admin-backend",
  "version": "1.0.0",
  "description": "Platform-administration backend for Dukana — admins, agents, onboarding, commissions, and support, kept in its own database and isolated from the shop-facing smart-duka-backend.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --test \"tests/*.test.js\"",
    "sync-indexes": "node scripts/syncIndexes.mjs",
    "seed-roles": "node scripts/seedRoles.mjs",
    "create-super-admin": "node scripts/createSuperAdminUser.mjs",
    "migrate-from-smartduka": "node scripts/migrateFromSmartDuka.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.5.2",
    "joi": "^17.10.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.5.0",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "nodemailer": "^8.0.11"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
