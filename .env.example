# Dukana Admin Backend — environment variables (names only; values supplied per-environment)

# --- Database (two separate Mongoose connections — see src/config/) ---
# Primary: this app's OWN new database — Role/AdminUser/Agent/Onboarding/
# CommissionRule/CommissionRecord/SupportTicket/AuditLog/refresh tokens live here.
ADMIN_MONGODB_URI=
# Secondary: reaches into the EXISTING smart-duka database (Shop/User/Subscription/
# SubscriptionPlan/PlatformConfig/Promotion/PushCampaign/SubscriptionPayment/
# MpesaTransaction). MUST be set to the exact same value as smart-duka-backend's
# own MONGO_URI — this is not a copy of the data, it's the same database.
SMARTDUKA_MONGODB_URI=
# Optional, both connections. Serverless-appropriate default of 5 already
# applies if unset — see the comment in src/config/adminDb.js on why a large
# pool buys nothing here and only spends Atlas's scarce connection slots.
MONGO_MAX_POOL_SIZE=5

# --- Auth ---
# Fresh secret — not the same value as anything in smart-duka-backend, and not
# currently set anywhere in production.
ADMIN_JWT_SECRET=
ADMIN_JWT_EXPIRES_IN=1h
AGENT_JWT_SECRET=
AGENT_JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=10

# --- Encryption ---
# MUST exactly equal smart-duka-backend's ENCRYPTION_KEY — this app decrypts
# PlatformConfig fields (Daraja/Paystack credentials) that smart-duka-backend
# encrypted. A mismatch fails silently (garbage plaintext, not an error), not
# loudly, so double check this one.
ENCRYPTION_KEY=

# --- Cron ---
# Gates GET /api/v1/cron/commission-accrual — same header-secret pattern as
# smart-duka-backend's cronRoutes.js.
CRON_SECRET=

# --- Internal service-to-service calls (smart-duka-backend's /internal/* routes) ---
# Shared secret — must match smart-duka-backend's INTERNAL_API_SECRET exactly.
INTERNAL_API_SECRET=
# Base URL of the smart-duka-backend deployment this app calls for payment
# reconciliation and push-campaign dispatch (e.g. https://api.dukana.app/api/v1).
SMARTDUKA_INTERNAL_API_URL=

# --- Rate limiting (Upstash Redis REST — optional, falls back to in-memory) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Outbound email (approval codes, etc.) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Platform-config step-up approval ---
# Comma-separated list of email addresses allowed to approve platform Daraja/
# Paystack credential access requests.
PLATFORM_CONFIG_APPROVER_EMAILS=

# --- Misc ---
PORT=5001
NODE_ENV=development
